                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:label="@string/launcher_name_pdf_viewer"
            android:name="com.basitce.htmltoapk.LauncherPdfViewer"
            android:enabled="false"
            android:exported="true"
            android:targetActivity="com.basitce.htmltoapk.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:label="@string/app_name"
            android:name="com.basitce.htmltoapk.LauncherDefault"
            android:enabled="true"
            android:exported="true"
