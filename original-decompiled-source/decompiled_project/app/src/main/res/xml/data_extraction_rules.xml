<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="."/>
        <exclude
            domain="sharedpref"
            path="."/>
        <exclude
            domain="file"
            path="keystores/"/>
        <exclude
            domain="file"
            path="default_keystore.p12"/>
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="."/>
        <exclude
            domain="sharedpref"
            path="."/>
        <exclude
            domain="file"
            path="keystores/"/>
        <exclude
            domain="file"
            path="default_keystore.p12"/>
    </device-transfer>
</data-extraction-rules>
